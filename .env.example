# AI StoryBound 本地开发环境变量模板
# 复制为 .dev.vars 并按需填写(敏感值写真实 Key)。.dev.vars 已被 gitignore,不会提交。
#
# 加载机制(为什么是 .dev.vars 而不是 .env):
# - dev 模式下 nitro-cloudflare-dev 调 wrangler getPlatformProxy,它只读取 .dev.vars + wrangler.toml [vars],
#   注入到 server 代码读取的 cloudflare binding env(event.context.cloudflare.env);
# - .env 只被 Nuxt 自身加载(process.env / NUXT_ runtimeConfig),不会进入 binding env,故本项目不使用。
# 部署:非敏感键配在 wrangler.toml [vars](已配置见下文),敏感键用 `wrangler secret put <KEY>` 设置。

# ═══ LLM 网关(server/utils/ai.ts 读取)═══
# AI_BASE_URL / AI_MODEL 已在 wrangler.toml [vars] 配置,本地无需重复;AI_API_KEY 必填,否则生成报 500
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash
AI_API_KEY=

# ═══ 认证(Better Auth,server/utils/auth.ts 读取)═══
# 必填,至少 32 位随机字符串;生产用 `wrangler secret put BETTER_AUTH_SECRET` 设置。
# 回调域名不配 BETTER_AUTH_URL,由 better-auth 按请求 Host 自动适配(本地 dev 自动为 localhost:4569)。
BETTER_AUTH_SECRET=

# ═══ 验证码邮件(Cloudflare Email Service — Email Sending,server/utils/email.ts 读取)═══
# 前置:发件域名需在 Cloudflare 控制台 onboard 到 Email Service(Email Sending 为 beta,需 Paid 计划)。
# EMAIL_FROM / CLOUDFLARE_ACCOUNT_ID 已在 wrangler.toml [vars] 配置;CF_API_TOKEN_SEND_EMAIL 为敏感键,
# 生产用 `wrangler secret put CF_API_TOKEN_SEND_EMAIL`;本地留空 → 验证码打印到服务器日志,流程仍可跑通。
EMAIL_FROM=no-reply@no-reply.orange-trees.com
CLOUDFLARE_ACCOUNT_ID=
CF_API_TOKEN_SEND_EMAIL=

# ═══ 微支付网关(server/api/payment/* 读取,参考 docs/payment-integration.md)═══
# 未配置时购买接口返回 500;PID 非敏感可入 wrangler vars,两个密钥为敏感键,生产用 wrangler secret put。
MICROPAY_PID=
MICROPAY_PRIVATE_KEY=
MICROPAY_PUBLIC_KEY=

# ═══ 管理员身份(兑换码管理接口,server/utils/authz.ts requireAdmin 读取)═══
# 填你自己注册登录用的邮箱,只有该账号能访问 /admin 与 /api/admin/* 接口;留空 = 全部管理接口 403。
# 非敏感,生产可放 wrangler.toml [vars],本地填 .dev.vars。
ADMIN_EMAIL=