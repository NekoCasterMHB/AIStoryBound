{
  "name": "AI Word2World",
  "private": true,
  "version": "0.1.0",
  "description": "AI 小说驱动互动游戏平台 —— 上传一本小说,选择一个身份,进入故事,并亲手改变原本的结局。",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:remote": "nuxt build --preset cloudflare_module && wrangler dev --remote",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "build:cf": "nuxt build --preset cloudflare_module",
    "deploy:cf": "nuxt build --preset cloudflare_module && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:local": "node scripts/d1-migrate.mjs --local",
    "db:migrate:remote": "node scripts/d1-migrate.mjs --remote",
    "seed:presets:local": "tsx scripts/seed-presets.ts --local",
    "seed:presets:remote": "tsx scripts/seed-presets.ts --remote",
    "seed:plugins:local": "tsx scripts/seed-plugins.ts --local",
    "seed:plugins:remote": "tsx scripts/seed-plugins.ts --remote",
    "prebuild:presets": "tsx scripts/prebuild-presets.ts",
    "demo:toy": "tsx scripts/demo/mvp3-device.mts",
    "gen:pwa-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/mdc": "^0.23.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "js-yaml": "^5.4.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@nuxt/eslint": "^1.17.0",
    "@types/js-yaml": "^4.0.9",
    "@vite-pwa/nuxt": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "nitro-cloudflare-dev": "^0.2.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.124.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver",
      "vue-demi",
      "@parcel/watcher",
      "rolldown",
      "workerd",
      "@cloudflare/workerd-linux-64"
    ]
  }
}